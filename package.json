{
  "name": "wireguard-macos-client",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal WireGuard client for macOS 11+ using Electron and Nuxt",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:nuxt\" \"npm:dev:electron\"",
    "dev:nuxt": "nuxt dev --host 127.0.0.1 --port 3333",
    "dev:electron": "wait-on http://127.0.0.1:3333 && electron .",
    "build:nuxt": "nuxt generate",
    "build": "npm run build:nuxt",
    "dist": "npm run build && electron-builder --mac",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "nuxt": "3.17.7",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "37.3.1",
    "electron-builder": "^26.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.example.wireguardmac",
    "productName": "WireGuard Mac",
    "asar": true,
    "files": [
      "electron/**/*",
      ".output/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "11.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}